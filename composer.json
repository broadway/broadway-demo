    "require": {
        "broadway/broadway-bundle": "^0.8",
        "broadway/event-store-dbal": "^0.7",
        "doctrine/doctrine-bundle": "^2.13",
        "ext-pdo_sqlite": "*",
        "php": "^8.2",
        "ramsey/uuid": "^4.0",
        "symfony/console": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/yaml": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "BroadwayDemo\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BroadwayDemo\\": "test/"
        }
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4",
        "symfony/css-selector": "^7.4"
    },
    "extra": {
        "symfony": {
            "allow-contrib": "true"
        }
    },
    "abandoned": true
}
